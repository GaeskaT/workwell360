# ── WorkWell 360 payments backend ────────────────────────────────────────────
# Copy to `.env` and fill in. Leave MPESA_CONSUMER_KEY blank to run in MOCK mode
# (no Safaricom calls — the full STK→callback→entitlement flow is simulated so you
# can test the plumbing before you have Daraja credentials).

PORT=8790
# Comma-separated allowed browser origins (the PWA). * is fine for local dev.
CORS_ORIGINS=http://127.0.0.1:8787,http://localhost:8787,https://gaeskat.github.io

# sandbox | production | mock   (auto = mock when MPESA_CONSUMER_KEY is empty)
MPESA_ENV=mock

# ── Daraja credentials (from developer.safaricom.co.ke) ──────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379

# Public HTTPS base that Safaricom can reach for the callback.
# Local dev: run a tunnel (ngrok/cloudflared) and paste its URL here.
MPESA_CALLBACK_BASE=https://REPLACE-WITH-YOUR-TUNNEL.example
# Unguessable path segment appended to the callback URL. Generate a random hex.
MPESA_CALLBACK_SECRET=change-me-to-a-random-32-hex-string

# Enable /dev/* helper routes (simulate callbacks). Turn OFF in production.
DEV_ROUTES=true

# ── Anonymous reporting ──────────────────────────────────────────────────────
# Handler (ombudsperson) API token — a long random string. Without it the
# /admin/reports endpoints are disabled. Keep it secret; rotate periodically.
REPORT_ADMIN_TOKEN=
# Optional: auto-purge reports marked Resolved/Closed after N days (0 = keep).
REPORT_RETENTION_DAYS=0

# ── Counsellor payouts (M-Pesa B2C) ──────────────────────────────────────────
COMMISSION_PLATFORM_PCT=0.2          # platform keeps 20%, counsellor gets 80%
PAYOUT_MAX_AUTO=20000                # payouts above this KES amount need manual approval
PAYOUT_ADMIN_TOKEN=                  # token for /admin/payouts* (falls back to REPORT_ADMIN_TOKEN)
MPESA_B2C_SHORTCODE=                 # your B2C shortcode (funded disbursement account)
MPESA_B2C_INITIATOR=                 # B2C API initiator username
MPESA_B2C_SECURITY_CREDENTIAL=       # initiator password encrypted with Safaricom's B2C cert
